---
import '../styles/us/style.css';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nosotros">
	<main>
		<section id="us" class="section-linked us">
			<h2 class="us__title">Sobre nosotros</h2>
			<article class="us__mission">
				<h3 class="us__mission__title">Nosotros</h3>
				<p class="us__mission__description">
					En la Fundación Vive La Cumbre transformamos la <strong>relación con el territorio</strong> fortaleciendo la conexión e interdependencia con la naturaleza, desarrollando <strong
						>capacidades socioemocionales</strong
					> y del <strong>pensamiento de diseño</strong> para llevar a cabo acciones cotidianas y colectivas que cuidan la vida de los territorios, enmarcadas en la circularidad, la acción climática y
					la justicia eco-social.
				</p>
			</article>
			<article class="us__vision">
				<h3 class="us__vision__title">¿Cómo lo hacemos?</h3>
				<p class="us__vision__description">
					Llevamos a cabo experiencias al aire libre con personas jóvenes y adultas, particularmente educadores/as basadas en las prácticas de la eco-educación experiencial y la aventura.
				</p>
			</article>
			<article class="us__mission">
				<h3 class="us__mission__title">¿Donde estamos?</h3>
				<img src="../img/ods/goal_13.jpeg" alt="Mapa de Colombia con departamentos de Antioquia, Caldas, Valle del Cauca, Risaralda, Guajira y Bogotá D.C resaltados" />
			</article>
		</section>

		<section id="us" class="section-linked us">
			<h2 class="us__title">Historia</h2>
			<article class="us__mission">
				<p class="us__mission__description">PENDIENTE DE ESCRIBIR</p>
			</article>
		</section>

		<section id="us" class="section-linked us">
			<h2 class="us__title">Equipo</h2>
			<article class="us__article">
				<button class="us__team-button" type="button">Coordinaciones </button>
			</article>
		</section>
	</main>
</Layout>
